# ---- Mahabharat AI Studio ----------------------------------------------------
# Copy to .env and adjust. API keys can ALSO be entered in the UI (AI Provider Settings), where they are
# stored AES-256-GCM-encrypted in MongoDB. Keys are never sent to the browser.

# API server
API_PORT=4000
API_HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=development

# 32-byte key that encrypts API keys stored in MongoDB (64 hex chars or base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. In development one is generated into .data/secrets.key if omitted.
SECRETS_MASTER_KEY=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mahabharat_ai_studio

# Redis (BullMQ). Use maxmemory-policy=noeviction.
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=mas

# Vector store: qdrant (default, local) or atlas (MongoDB Atlas Vector Search)
VECTOR_STORE=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mas_document_chunks

# Local asset storage (PDFs, audio, scene clips, renders). Defaults to ./storage
STORAGE_DIR=
MAX_UPLOAD_MB=1024

# Provider keys (optional here — prefer the Settings UI)
# OpenAI = all text work (outline, scripts, Hinglish, OCR, embeddings); Gemini = video generation.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ELEVENLABS_API_KEY=

# Tool paths (defaults assume they are on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PDFTOTEXT_PATH=pdftotext
PDFTOPPM_PATH=pdftoppm
PDFINFO_PATH=pdfinfo
TESSERACT_PATH=tesseract

# Web (Next.js) → API proxy target
API_URL=http://127.0.0.1:4000
